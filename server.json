{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dir-ai/repotector",
  "description": "The repo guardian AI agents handshake with before they touch your code.",
  "version": "1.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "repotector",
      "version": "1.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "subcommand",
          "value": "mcp"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/dir-ai/repotector",
    "source": "github"
  }
}
